                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnZoom100Click" Content="100%" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnFitToWindowClick" Content="Fit to Window" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnOpenSlideSnippetsClick" FontWeight="SemiBold"
                                            Content="Presentation Slides…"
                                            ToolTipService.ToolTip="Manage Presentation Mode Slide Snippets, Step Through Frames &amp; Export Multi-Slide .pptx" />
                                </StackPanel>
                                <TextBlock Text="Zoom &amp; Presentation" Style="{StaticResource VexioRibbonGroupLabelStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 8. DEVELOPER RIBBON PANEL (ShapeSheet, 8 Boolean Ops, Diagram-as-Code & Sandboxed Macro Editor) -->
                        <StackPanel x:Name="RibbonPanelDeveloper" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Height="56">
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnToggleShapeSheetClick" FontWeight="SemiBold" Content="Show ShapeSheet (Shift+F5)" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnGuardSelectedCellClick" Content="Wrap in GUARD()" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnEnsureControlHandleClick" Content="+ Control Handle" ToolTipService.ToolTip="Attach Yellow Parametric Controls.Row_1 Diamond Handle" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnResetConnectorRoutingClick" Content="Reset Route" ToolTipService.ToolTip="Restore Automatic A* Orthogonal Routing on Selected Connector" />
                                </StackPanel>
                                <TextBlock Text="Shape Design" Style="{StaticResource VexioRibbonGroupLabelStyle}" />
                            </StackPanel>
                            <AppBarSeparator />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Height="56">
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanUnionClick" Content="Union" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanCombineClick" Content="Combine" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanFragmentClick" Content="Fragment" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanIntersectClick" Content="Intersect" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanSubtractClick" Content="Subtract" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanTrimClick" Content="Trim" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanJoinClick" Content="Join" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnBooleanOffsetClick" Content="Offset" />
                                </StackPanel>
                                <TextBlock Text="Boolean Geometry Operations (8 Modes)" Style="{StaticResource VexioRibbonGroupLabelStyle}" />
                            </StackPanel>
                            <AppBarSeparator />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Height="56">
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnOpenMarkupStudioClick" FontWeight="SemiBold"
                                            Content="Mermaid / PlantUML / DOT…"
                                            ToolTipService.ToolTip="Bidirectional Mermaid (.mmd), PlantUML (.puml) &amp; Graphviz DOT (.dot) Studio" />
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnOpenMacroEditorClick" FontWeight="SemiBold"
                                            Content="Sandboxed Macro Editor (Alt+F9)" />
                                </StackPanel>
                                <TextBlock Text="Diagram-as-Code &amp; Automation" Style="{StaticResource VexioRibbonGroupLabelStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- ROW 2: WORKSPACE DIAGNOSTIC INFOBAR                                 -->
        <!-- =================================================================== -->
        <InfoBar x:Name="WorkspaceInfoBar" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Informational" />

        <!-- =================================================================== -->
        <!-- ROW 3: MAIN WORKSTATION AREA                                        -->
        <!-- =================================================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Col 0: Collapsible Left Shapes / Stencils Dock (All 17 Visio Categories) -->
                <ColumnDefinition x:Name="LeftStencilColumn" Width="268" />
                <!-- Col 1: Persistent Vertical Drawing Tool Rail (All 16 Basic Drawing & Diagramming Tools) -->
                <ColumnDefinition Width="56" />
                <!-- Col 2: Center Ruler + DirectX 12 SwapChainPanel + Floating Formula Bar -->
                <ColumnDefinition Width="*" />
                <!-- Col 3: Dockable Right Task Panes -->
                <ColumnDefinition x:Name="RightTaskPaneColumn" Width="328" />
            </Grid.ColumnDefinitions>

            <!-- =============================================================== -->
            <!-- COL 0: COLLAPSIBLE LEFT SHAPES / STENCILS DOCK                  -->
            <!-- =============================================================== -->
            <Border x:Name="LeftStencilDockBorder" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,0,1,0" Padding="8"
                    AllowDrop="True" DragOver="OnStencilDockDragOver" Drop="OnStencilDockDrop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header + Collapse Button -->
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="StencilHeaderCountText" Text="Shapes (33 Categories)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Padding="6,2" Background="Transparent" BorderBrush="Transparent"
                                Click="OnToggleLeftStencilDockClick" ToolTipService.ToolTip="Collapse Shapes Dock">
                            <PathIcon Width="12" Height="12" Data="M 10,2 L 4,8 L 10,14" />
                        </Button>
                    </Grid>

                    <!-- Instant Stencil Search -->
                    <TextBox x:Name="StencilSearchBox" Grid.Row="1" PlaceholderText="Search 756+ shapes in 33 packs..."
                             TextChanged="OnStencilSearchTextChanged" />

                    <!-- Stencil Pack Switcher (Populated Dynamically with All 22 Visio, Microsoft, Server & Network Categories) -->
                    <ComboBox x:Name="StencilPackCombo" Grid.Row="2" HorizontalAlignment="Stretch"
                              SelectionChanged="OnStencilPackSelectionChanged" />

                    <!-- Drag-Source Stencil Items -->
                    <ListView x:Name="StencilMastersListView" Grid.Row="3"
                              CanDragItems="True"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              DragItemsStarting="OnStencilMasterDragStarting"
                              ItemClick="OnStencilMasterItemClick" />

                    <!-- Import Visio Stencil (.vssx / .vss / .zip) + Official Stencil Packs -->
                    <Grid Grid.Row="4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ImportStencilDockButton" Grid.Column="0" HorizontalAlignment="Stretch" Padding="6,5"
                                Click="OnImportStencilClick" FontWeight="SemiBold"
                                ToolTipService.ToolTip="Import Visio Stencil (.vssx, .vss, .vssm, .zip, .svg, .vsdx) or drop files here">
                            <TextBlock x:Name="ImportStencilDockLabel" Text="+ Stencil / .zip" FontSize="11" />
                        </Button>
                        <Button x:Name="OfficialStencilCatalogButton" Grid.Column="1" HorizontalAlignment="Stretch" Padding="6,5"
                                Click="OnOpenOfficialStencilCatalogClick" FontWeight="SemiBold" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="1-Click Official Microsoft 365, Azure V25, Cisco, Panduit &amp; APC Stencil Catalog">
                            <TextBlock Text="Official Packs ↓" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Quick Drop Hint -->
                    <TextBlock Grid.Row="5" Text="Click, drag onto canvas, or drop .vssx/.vss/.zip files here."
                               FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- =============================================================== -->
            <!-- COL 1: PERSISTENT VERTICAL DRAWING TOOL RAIL (16 BASIC TOOLS)   -->
            <!-- =============================================================== -->
            <Border Grid.Column="1" Background="{ThemeResource VexioRibbonSurfaceBrush}"
                    BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="4,6">
                    <StackPanel x:Name="DrawingToolRailPanel" Spacing="3">
                        <ToggleButton Tag="0" Click="OnRailToolClick" IsChecked="True" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Select / Pointer (Ctrl+1)">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 3,1 L 3,13 L 6.5,9.8 L 9,15 L 11,14 L 8.5,9 L 13,9 Z" /><TextBlock Text="Select" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="1" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Pan Canvas">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 8,1 L 11,4 L 9,4 L 9,7 L 12,7 L 12,5 L 15,8 L 12,11 L 12,9 L 9,9 L 9,12 L 11,12 L 8,15 L 5,12 L 7,12 L 7,9 L 4,9 L 4,11 L 1,8 L 4,5 L 4,7 L 7,7 L 7,4 L 5,4 Z" /><TextBlock Text="Pan" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <MenuFlyoutSeparator />
                        <ToggleButton Tag="2" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Dynamic Connector (Ctrl+3)">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 2,3 L 5,3 L 5,6 L 2,6 Z M 5,4.5 L 10,4.5 L 10,11.5 L 12,11.5 M 11,10 L 14,10 L 14,13 L 11,13 Z" /><TextBlock Text="Connect" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="9" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Straight Line Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 2,14 L 14,2" /><TextBlock Text="Line" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="10" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Curved Arc Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 2,13 C 2,5 8,2 14,3" /><TextBlock Text="Arc" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="11" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Freeform Spline Curve">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 1,12 C 4,2 11,14 15,3" /><TextBlock Text="Curve" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <MenuFlyoutSeparator />
                        <ToggleButton Tag="4" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Rectangle Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 2,3 L 14,3 L 14,13 L 2,13 Z" /><TextBlock Text="Rect" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="5" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Rounded Rectangle Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 4,3 L 12,3 L 14,5 L 14,11 L 12,13 L 4,13 L 2,11 L 2,5 Z" /><TextBlock Text="Round" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="6" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Circle / Ellipse Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 8,2 A 6,6 0 1 1 7.99,2 Z" /><TextBlock Text="Circle" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="7" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Decision Diamond Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 8,1 L 15,8 L 8,15 L 1,8 Z" /><TextBlock Text="Diamond" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="8" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Triangle Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 8,2 L 15,14 L 1,14 Z" /><TextBlock Text="Triangle" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="14" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Hexagon Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 4.5,2 L 11.5,2 L 15,8 L 11.5,14 L 4.5,14 L 1,8 Z" /><TextBlock Text="Hexagon" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="15" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="5-Point Star Tool">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 8,1 L 10,6 L 15,6 L 11,9.5 L 12.5,15 L 8,11.8 L 3.5,15 L 5,9.5 L 1,6 L 6,6 Z" /><TextBlock Text="Star" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <MenuFlyoutSeparator />
                        <ToggleButton Tag="3" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Text Box Tool (Ctrl+2)">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 2,2 L 14,2 L 14,5 L 12,5 L 12,4 L 9,4 L 9,14 L 7,14 L 7,4 L 4,4 L 4,5 L 2,5 Z" /><TextBlock Text="Text" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="12" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Markup Ink Pen">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 11,2 L 14,5 L 5,14 L 2,14 L 2,11 Z" /><TextBlock Text="Pen" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Tag="13" Click="OnRailToolClick" HorizontalAlignment="Stretch" Padding="2,4" ToolTipService.ToolTip="Markup Highlighter">
                            <StackPanel Spacing="1"><PathIcon Width="13" Height="13" Data="M 9,2 L 14,7 L 7,14 L 2,14 L 2,9 Z" /><TextBlock Text="Marker" FontSize="9.5" HorizontalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- =============================================================== -->
            <!-- COL 2: CENTER RULERS + DX12 SWAPCHAINPANEL + FORMULA BAR        -->
            <!-- =============================================================== -->
            <Grid Grid.Column="2" Background="{ThemeResource VexioCanvasBackdropBrush}">
                <Grid.RowDefinitions>
                    <!-- Floating Formula Bar (when ShapeSheet is active) -->
                    <RowDefinition Height="Auto" />
                    <!-- Top Horizontal Ruler -->
                    <RowDefinition x:Name="TopRulerRow" Height="24" />
                    <!-- Canvas Row -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Left Vertical Ruler -->
                    <ColumnDefinition x:Name="LeftRulerColumn" Width="24" />
                    <!-- DX12 SwapChain Column -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Floating Formula Bar (Active in ShapeSheet Mode) -->
                <Border x:Name="FloatingFormulaBar" Grid.Row="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFE0E7FF" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="FloatingCellRefText" Text="Sheet.1!Width" Foreground="#FF1E3A8A" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" />
                        </Border>

                        <ToggleButton x:Name="FloatingForceSetfToggle" Grid.Column="1" Content="SETF Override" FontSize="11.5" Padding="8,3"
                                      Click="OnFloatingForceSetfToggled" ToolTipService.ToolTip="Bypass GUARD(expr) using SETF semantics" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Padding="6,3" Click="OnRevertFormulaClick" ToolTipService.ToolTip="Revert Formula">
                                <TextBlock Text="✕" FontSize="11" />
                            </Button>
                            <Button Padding="6,3" Click="OnCommitFloatingFormulaClick" ToolTipService.ToolTip="Commit Formula (Enter)">
                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" />
                            </Button>
                        </StackPanel>

                        <TextBox x:Name="FloatingFormulaTextBox" Grid.Column="3" FontFamily="Consolas" FontSize="12.5"
                                 PlaceholderText="=GUARD(Width*0.5)" KeyDown="OnFloatingFormulaKeyDown" />

                        <Border Grid.Column="4" Background="#FFF1F5F9" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="FloatingEvaluatedValueText" Text="= 2.0000 in" Foreground="#FF0F172A" FontFamily="Consolas" FontSize="11.5" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Ruler Origin Unit Switcher (in / mm) -->
                <Button x:Name="RulerUnitOriginButton" Grid.Row="1" Grid.Column="0" Padding="0" CornerRadius="0"
                        Background="{ThemeResource VexioRulerSurfaceBrush}" BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,0,1,1"
                        Click="OnToggleRulerUnitClick" ToolTipService.ToolTip="Switch Ruler Display Units (in / mm)">
                    <TextBlock x:Name="RulerUnitOriginText" Text="mm" FontSize="9.5" FontWeight="SemiBold" Foreground="#FF334155" />
                </Button>

                <!-- Horizontal Ruler Overlay -->
                <Border x:Name="HorizontalRulerBorder" Grid.Row="1" Grid.Column="1" Background="{ThemeResource VexioRulerSurfaceBrush}"
                        BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,0,0,1">
                    <Canvas x:Name="HorizontalRulerCanvas" SizeChanged="OnRulerCanvasSizeChanged">
                        <Line x:Name="HorizontalCursorHairline" X1="0" Y1="0" X2="0" Y2="24" Stroke="#FF2563EB" StrokeThickness="1.5" />
                    </Canvas>
                </Border>

                <!-- Vertical Ruler Overlay -->
                <Border x:Name="VerticalRulerBorder" Grid.Row="2" Grid.Column="0" Background="{ThemeResource VexioRulerSurfaceBrush}"
                        BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,0,1,0">
                    <Canvas x:Name="VerticalRulerCanvas" SizeChanged="OnRulerCanvasSizeChanged">
                        <Line x:Name="VerticalCursorHairline" X1="0" Y1="0" X2="24" Y2="0" Stroke="#FF2563EB" StrokeThickness="1.5" />
                    </Canvas>
                </Border>

                <!-- 120 FPS DirectX 12 wgpu SwapChainPanel + Double-Click Inline Label Editor + Right-Click Menu -->
                <SwapChainPanel x:Name="DiagramSwapChainPanel"
                                Grid.Row="2"
                                Grid.Column="1"
                                AllowDrop="True"
                                IsTapEnabled="True"
                                IsDoubleTapEnabled="True"
                                IsRightTapEnabled="True"
                                Loaded="OnSwapChainPanelLoaded"
                                SizeChanged="OnSwapChainPanelSizeChanged"
                                CompositionScaleChanged="OnSwapChainCompositionScaleChanged"
                                PointerPressed="OnCanvasPointerPressed"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerReleased="OnCanvasPointerReleased"
                                PointerWheelChanged="OnCanvasPointerWheelChanged"
                                DoubleTapped="OnCanvasDoubleTapped"
                                RightTapped="OnCanvasRightTapped"
                                DragOver="OnCanvasDragOver"
                                Drop="OnCanvasDrop"
                                AutomationProperties.Name="DirectX 12 Diagram Canvas">
                    <Image x:Name="SoftwareCanvasFallbackImage" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
                    <!-- Non-blocking HUD Pill for Collapsed Dock Restore & Active Tool -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsHitTestVisible="True">
                        <Button x:Name="RestoreStencilsPillButton" Visibility="Collapsed" Content="Show Shapes" FontSize="11.5" Padding="8,4"
                                Click="OnToggleLeftStencilDockClick" />
                        <Border Background="#CC0F172A" CornerRadius="4" Padding="8,3" IsHitTestVisible="False">
                            <TextBlock x:Name="CanvasOverlayHudText" Text="Select Tool • Double-Click Stencil to Edit Text" Foreground="White" FontSize="11" />
                        </Border>
                    </StackPanel>

                    <!-- Pure In-Place Canvas Text Label Editor (Directly Over Shape or Below-Icon Caption) -->
                    <Canvas x:Name="InlineEditorOverlayCanvas" IsHitTestVisible="True">
                        <Border x:Name="InlineCanvasEditorBorder" Visibility="Collapsed" RequestedTheme="Light"
                                Background="#FFFFFFFF" BorderBrush="#FF2563EB" BorderThickness="1.5" CornerRadius="2" Padding="2,1">
                            <TextBox x:Name="InlineCanvasTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     TextAlignment="Center" MinWidth="120" MinHeight="24" FontSize="12" Padding="3,2"
                                     Foreground="#FF0F172A" BorderThickness="0" Background="Transparent" PlaceholderText=""
                                     KeyDown="OnInlineCanvasTextKeyDown" LostFocus="OnInlineCanvasTextLostFocus" />
                        </Border>
                    </Canvas>
                </SwapChainPanel>
            </Grid>

            <!-- =============================================================== -->
            <!-- COL 3: DOCKABLE RIGHT TASK PANES (6 COMPLETE TABS)              -->
            <!-- =============================================================== -->
            <Border x:Name="RightTaskPaneBorder" Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="1,0,0,0">
                <Pivot x:Name="RightTaskPanesPivot" Title="Inspector &amp; Task Panes" FontSize="12">
                    <!-- PANE 1: SHAPE DATA (Prop.*) -->
                    <PivotItem Header="Shape Data">
                        <ScrollViewer Padding="4,8,8,12">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="ShapeDataHeaderText" Text="Selected: Sheet.1 (Process Step)" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBox x:Name="PropLabelTextBox" Header="Prop.Label" Text="Order Validation" LostFocus="OnShapeDataFieldCommitted" />
                                <TextBox x:Name="PropDepartmentTextBox" Header="Prop.Department" Text="Operations" LostFocus="OnShapeDataFieldCommitted" />
                                <TextBox x:Name="PropOwnerTextBox" Header="Prop.Owner" Text="Platform Team" LostFocus="OnShapeDataFieldCommitted" />
                                <TextBox x:Name="PropCostTextBox" Header="Prop.Cost (USD)" Text="1250.00" LostFocus="OnShapeDataFieldCommitted" />
                                <ComboBox x:Name="PropStatusCombo" Header="Prop.Status" HorizontalAlignment="Stretch" SelectedIndex="1"
                                          SelectionChanged="OnPropStatusChanged">
                                    <x:String>Draft</x:String>
                                    <x:String>Active</x:String>
                                    <x:String>Approved</x:String>
                                    <x:String>Blocked</x:String>
                                </ComboBox>
                                <Button HorizontalAlignment="Stretch" Click="OnApplyShapeDataClick" Content="Commit Shape Data to ShapeSheet" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <!-- PANE 2: SIZE & POSITION -->
                    <PivotItem Header="Size &amp; Pos">
                        <ScrollViewer Padding="4,8,8,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Canonical Shape Transform (1:1 ShapeSheet)" FontWeight="SemiBold" FontSize="12" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="TransformPinXBox" Grid.Row="0" Grid.Column="0" Header="PinX" Text="4.25 in" />
                                    <TextBox x:Name="TransformPinYBox" Grid.Row="0" Grid.Column="1" Header="PinY" Text="5.50 in" />
                                    <TextBox x:Name="TransformWidthBox" Grid.Row="1" Grid.Column="0" Header="Width" Text="2.00 in" />
                                    <TextBox x:Name="TransformHeightBox" Grid.Row="1" Grid.Column="1" Header="Height" Text="1.00 in" />
                                    <TextBox x:Name="TransformLocPinXBox" Grid.Row="2" Grid.Column="0" Header="LocPinX" Text="Width*0.5" />
                                    <TextBox x:Name="TransformLocPinYBox" Grid.Row="2" Grid.Column="1" Header="LocPinY" Text="Height*0.5" />
                                    <TextBox x:Name="TransformAngleBox" Grid.Row="3" Grid.ColumnSpan="2" Header="Angle" Text="0 deg" />
                                </Grid>
                                <Button HorizontalAlignment="Stretch" Click="OnApplySizeAndPositionClick" Content="Apply Transform Cells" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <!-- PANE 3: FORMAT SHAPE -->
                    <PivotItem Header="Format">
                        <ScrollViewer Padding="4,8,8,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Fill &amp; Stroke Cells" FontWeight="SemiBold" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Pick Fill Color ▾">
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="InspFillColorPickerControl"
                                                             ColorSpectrumShape="Box"
                                                             IsMoreButtonVisible="True"
                                                             IsColorSliderVisible="True"
                                                             IsColorChannelTextInputVisible="True"
                                                             IsHexInputVisible="True"
                                                             IsAlphaEnabled="False"
                                                             ColorChanged="OnShapeFillColorPickerChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Content="Pick Line Color ▾">
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="InspLineColorPickerControl"
                                                             ColorSpectrumShape="Box"
                                                             IsMoreButtonVisible="True"
                                                             IsColorSliderVisible="True"
                                                             IsColorChannelTextInputVisible="True"
                                                             IsHexInputVisible="True"
                                                             IsAlphaEnabled="False"
                                                             ColorChanged="OnShapeLineColorPickerChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <TextBox x:Name="FormatFillForegndBox" Header="FillForegnd (RGB Formula)" Text="RGB(59,130,246)" />
                                <Slider x:Name="FormatFillTransSlider" Header="FillForegndTrans (%)" Minimum="0" Maximum="100" Value="8" />
                                <TextBox x:Name="FormatLineColorBox" Header="LineColor (RGB Formula)" Text="RGB(30,58,138)" />
                                <TextBox x:Name="FormatLineWeightBox" Header="LineWeight" Text="1.5 pt" />
                                <TextBox x:Name="FormatRoundingBox" Header="Rounding" Text="0.08 in" />
                                <ComboBox x:Name="FormatEndArrowCombo" Header="EndArrow" HorizontalAlignment="Stretch" SelectedIndex="1">
                                    <x:String>0 — None</x:String>
                                    <x:String>4 — Filled Triangle</x:String>
                                    <x:String>13 — Open Stealth</x:String>
                                    <x:String>10 — Crow's Foot</x:String>
                                </ComboBox>
                                <Button HorizontalAlignment="Stretch" Click="OnApplyFormatShapeClick" Content="Commit Fill &amp; Line Cells" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <!-- PANE 4: PAN & ZOOM -->
                    <PivotItem Header="Pan &amp; Zoom">
                        <StackPanel Spacing="10" Padding="4,8,8,12">
                            <TextBlock Text="Offscreen Page Bird's-Eye Preview" FontWeight="SemiBold" FontSize="12" />
                            <Border Height="156" Background="#FFFFFFFF" BorderBrush="#FF94A3B8" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Image x:Name="PanZoomPreviewImage" Stretch="Uniform" />
                                    <Rectangle Stroke="#FF2563EB" StrokeThickness="1.5" Fill="#1A2563EB" Width="120" Height="78"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button HorizontalAlignment="Stretch" Click="OnRefreshPanZoomPreviewClick" Content="Refresh Offscreen Preview" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Button Click="OnZoom50Click" Content="50%" />
                                <Button Click="OnZoom100Click" Content="100%" />
                                <Button Click="OnZoom200Click" Content="200%" />
                                <Button Click="OnFitToWindowClick" Content="Fit" />
                            </StackPanel>
                        </StackPanel>
                    </PivotItem>

                    <!-- PANE 5: EXTERNAL DATA -->
                    <PivotItem Header="External Data">
                        <StackPanel Spacing="8" Padding="4,8,8,12">
                            <TextBlock x:Name="ExternalDataSourceStatusText" Text="Source: Enterprise_Inventory.xlsx (Synced)" FontWeight="SemiBold" FontSize="12" />
                            <ListView x:Name="ExternalDataRowsListView" Height="180" SelectionMode="Single" />
                            <Button HorizontalAlignment="Stretch" Click="OnBindSelectedDataRowClick" Content="Link Selected Row to Active Shape" />
                            <Button HorizontalAlignment="Stretch" Click="OnPushTwoWaySyncClick" Content="Write Shape Changes Back to Source" />
                        </StackPanel>
                    </PivotItem>

                    <!-- PANE 6: LAYER PROPERTIES -->
                    <PivotItem Header="Layers">
                        <StackPanel Spacing="8" Padding="4,8,8,12">
                            <TextBlock Text="Document &amp; CAD Layer Manager" FontWeight="SemiBold" FontSize="12" />
                            <ListView x:Name="LayersListView" Height="195" SelectionMode="Single" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewLayerNameBox" Grid.Column="0" PlaceholderText="New layer name..." />
                                <Button Grid.Column="1" Click="OnAddLayerClick" Content="Add Layer" />
                            </Grid>
                        </StackPanel>
                    </PivotItem>
                </Pivot>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- ROW 4: SHAPESHEET SPLIT-VIEW GRIDSPLITTER                           -->
        <!-- =================================================================== -->
        <Border x:Name="ShapeSheetGridSplitter" Grid.Row="4" Visibility="Collapsed"
                Background="{ThemeResource VexioRibbonGroupBorderBrush}"
                PointerPressed="OnShapeSheetSplitterPointerPressed"
                PointerMoved="OnShapeSheetSplitterPointerMoved"
                PointerReleased="OnShapeSheetSplitterPointerReleased"
                AutomationProperties.Name="ShapeSheet GridSplitter"
                ToolTipService.ToolTip="Drag to resize ShapeSheet Split-View">
            <Border Width="44" Height="3" CornerRadius="1.5" Background="#FF64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- =================================================================== -->
        <!-- ROW 5: DOCKABLE BOTTOM SHAPESHEET EDITOR SPLIT-VIEW                 -->
        <!-- =================================================================== -->
        <Border x:Name="ShapeSheetSplitPane" Grid.Row="5" Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ShapeSheet Header: Target Shape + Section Selector + GUARD / SETF Controls -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ShapeSheetTitleText" Grid.Column="0" Text="ShapeSheet — Sheet.1"
                               FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />

                    <ComboBox x:Name="ShapeSheetSectionCombo" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="OnShapeSheetSectionChanged">
                        <x:String>Shape Transform</x:String>
                        <x:String>1-D Endpoints</x:String>
                        <x:String>Geometry 1</x:String>
                        <x:String>Protection</x:String>
                        <x:String>Controls</x:String>
                        <x:String>Connection Points</x:String>
                        <x:String>User-defined Cells</x:String>
                        <x:String>Shape Data (Prop.*)</x:String>
                    </ComboBox>

                    <TextBox x:Name="ShapeSheetFormulaEditorBox" Grid.Column="2" FontFamily="Consolas" FontSize="12.5"
                             PlaceholderText="Select a cell and enter a ShapeSheet formula (e.g. GUARD(Width*0.5))..."
                             KeyDown="OnShapeSheetFormulaKeyDown" />

                    <Button Grid.Column="3" Click="OnGuardSelectedCellClick" Content="GUARD(expr)" FontSize="11.5"
                            ToolTipService.ToolTip="Wrap current formula in GUARD(...) to block interactive SetValue overrides" />

                    <ToggleButton x:Name="ShapeSheetForceSetfToggle" Grid.Column="4" Content="Force SETF" FontSize="11.5"
                                  Click="OnShapeSheetForceSetfToggled"
                                  ToolTipService.ToolTip="When checked, commits with force_setf=true to replace GUARD expressions" />

                    <Button Grid.Column="5" Click="OnCommitShapeSheetFormulaClick" FontWeight="SemiBold" Content="Commit Cell" FontSize="11.5" />
                </Grid>

                <!-- Column Headers -->
                <Grid Grid.Row="1" Padding="8,2" Background="{ThemeResource VexioRibbonSurfaceBrush}" CornerRadius="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Cell Name" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Formula (Canonical Expression)" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Evaluated Value" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Protection" FontSize="11" FontWeight="SemiBold" />
                </Grid>

                <!-- Live Cell Rows -->
                <ListView x:Name="ShapeSheetCellsListView" Grid.Row="2" SelectionMode="Single"
                          SelectionChanged="OnShapeSheetCellSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Padding" Value="2,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- ROW 6: BOTTOM PAGE TABS STRIP                                       -->
        <!-- =================================================================== -->
        <Border Grid.Row="6" Background="{ThemeResource VexioRibbonSurfaceBrush}"
                BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,1,0,0" Padding="8,0">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- All Pages Popup & Reorder Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Padding="6,2" Background="Transparent" BorderBrush="Transparent" Click="OnMovePageLeftClick"
                            ToolTipService.ToolTip="Move Active Page Left">
                        <TextBlock Text="◀" FontSize="10" />
                    </Button>
                    <Button Padding="6,2" Background="Transparent" BorderBrush="Transparent" Click="OnMovePageRightClick"
                            ToolTipService.ToolTip="Move Active Page Right">
                        <TextBlock Text="▶" FontSize="10" />
                    </Button>
                </StackPanel>

                <!-- Single-Line Horizontally Scrollable Page Tabs Strip -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" VerticalAlignment="Center">
                    <StackPanel x:Name="PageTabsStripPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                </ScrollViewer>

                <!-- Insert Page & Rename Page Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Padding="8,2" Click="OnInsertBlankPageClick" ToolTipService.ToolTip="Insert Foreground Page">
                        <TextBlock Text="+ Insert Page" FontSize="11.5" />
                    </Button>
                    <Button Padding="8,2" Click="OnRenameActivePageClick" ToolTipService.ToolTip="Rename Active Page">
                        <TextBlock x:Name="BottomRenamePageLabel" Text="Rename" FontSize="11.5" />
                    </Button>
                </StackPanel>

                <!-- Active Scale & Layer Summary -->
                <TextBlock x:Name="PageScaleSummaryText" Grid.Column="3" Text="Scale: 1:1 • Units: Inches"
                           FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- ROW 7: ENTERPRISE STATUS BAR                                        -->
        <!-- =================================================================== -->
        <Grid Grid.Row="7" Background="{StaticResource VexioStatusBarBrush}" Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusPageIndicatorText" Grid.Column="0" Text="Page 1 of 2"
                       Foreground="{StaticResource VexioStatusBarForegroundBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0" />

            <TextBlock x:Name="StatusShapeCountText" Grid.Column="1" Text="Shapes: 4 • Selected: Sheet.1"
                       Foreground="{StaticResource VexioStatusBarForegroundBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0" />

            <TextBlock x:Name="StatusCoordinatesText" Grid.Column="2" Text="X: 0.00 in   Y: 0.00 in"
                       Foreground="#FFDBEAFE" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />

            <Button x:Name="StatusValidationBadgeButton" Grid.Column="3" Padding="8,1" Background="#26FFFFFF" BorderBrush="Transparent"
                    Foreground="White" Click="OnCheckDiagramClick" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Run BPMN 2.0 / UML 2.5 / SharePoint Diagram Validator">
                <TextBlock x:Name="StatusValidationBadgeText" Text="✓ 0 Validation Issues (BPMN 2.0)" FontSize="11" />
            </Button>

            <TextBlock x:Name="StatusAutomationText" Grid.Column="4" Text="VBA Sandbox: Deterministic Ready"
                       Foreground="#FFBFDBFE" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />

            <!-- Zoom Controls -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="StatusZoomPercentText" Text="100%" Foreground="White" FontSize="11.5" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="StatusZoomSlider" Width="116" Minimum="25" Maximum="400" Value="100" StepFrequency="5"
                        ValueChanged="OnZoomSliderValueChanged" VerticalAlignment="Center" />
                <Button Padding="6,2" Background="#26FFFFFF" BorderBrush="Transparent" Foreground="White"
                        Click="OnFitToWindowClick" ToolTipService.ToolTip="Fit Page to Window">
                    <PathIcon Width="12" Height="12" Data="M 1,5 L 1,1 L 5,1 M 11,1 L 15,1 L 15,5 M 15,11 L 15,15 L 11,15 M 5,15 L 1,15 L 1,11" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- =================================================================== -->
        <!-- IN-APP WELCOME / FILE BACKSTAGE HUB (NO EXTERNAL LAUNCH DIALOG)     -->
        <!-- =================================================================== -->
        <Border x:Name="InAppBackstageOverlay" Grid.Row="1" Grid.RowSpan="7" Visibility="Visible"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True"
                DragOver="OnBackstageDragOver" Drop="OnBackstageDrop">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="324" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Focused Startup Rail (Open, New Blank, Continue, Updates) -->
                <Border Grid.Column="0" Background="{StaticResource VexioBrandDarkHeaderBrush}" Padding="16,20">
                    <StackPanel Spacing="10">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                                Background="#33FFFFFF" Foreground="White" BorderBrush="Transparent"
                                Click="OnCloseBackstageClick">
                            <TextBlock x:Name="BackstageReturnLabel" Text="← Continue to Canvas" FontWeight="SemiBold" />
                        </Button>

                        <MenuFlyoutSeparator />

                        <TextBlock x:Name="BackstageTitleLabel" Text="Vexio Professional" Foreground="White" FontSize="17" FontWeight="Bold" Margin="4,4,0,2" />
                        <TextBlock Text="1:1 Visio &amp; Offline CAD Suite" Foreground="#FFBAE6FD" FontSize="11.5" Margin="4,0,0,8" />

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,9"
                                Background="#FF2563EB" Foreground="White" BorderBrush="Transparent"
                                Click="OnOpenClick" Content="Open Diagram or CAD File... (Ctrl+O)" FontWeight="SemiBold" />

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8"
                                Background="#1FFFFFFF" Foreground="White" BorderBrush="Transparent"
                                Click="OnNewBlankA4MetricClick" Content="+ New Blank Diagram" />

                        <MenuFlyoutSeparator />

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                                Background="#26FFFFFF" Foreground="#FFBAE6FD" BorderBrush="Transparent"
                                Click="OnCheckUpdatesClick" Content="Check for Updates..." />
                    </StackPanel>
                </Border>

                <!-- Center Startup Hub: New Blank Diagram, Starter Templates, Dropzone & Preferences -->
                <ScrollViewer Grid.Column="1" Padding="32,26">
                    <StackPanel Spacing="22" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="BackstageHeroHeading" Text="Start or Open a Diagram Inside Vexio" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="Start a clean blank diagram, pick a 1:1 Visio starter template, or drop any .vsdx, .vsd, .vdx, .dwg, or .dxf file directly into this window."
                                       FontSize="12.5" Opacity="0.78" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Single New Blank Diagram Hero Card -->
                        <Button Padding="18,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnNewBlankA4MetricClick">
                            <StackPanel Spacing="4">
                                <TextBlock Text="New Blank Diagram" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="Start immediately on a clean canvas — customize page size, orientation, background &amp; units anytime inside the workspace." FontSize="12" Opacity="0.78" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>

                        <!-- Starter Templates -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="1:1 Visio Professional Starter Templates" FontSize="14" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Width="220" Padding="14,12" HorizontalContentAlignment="Left" Click="OnNewBpmnTemplateClick">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="BPMN 2.0 Process" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Validated Swimlanes &amp; Gateways" FontSize="11" Opacity="0.75" />
                                    </StackPanel>
                                </Button>
                                <Button Width="220" Padding="14,12" HorizontalContentAlignment="Left" Click="OnNewUmlTemplateClick">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Cloud &amp; Network Topology" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Firewalls, Switches, Servers &amp; VPCs" FontSize="11" Opacity="0.75" />
                                    </StackPanel>
                                </Button>
                                <Button Width="220" Padding="14,12" HorizontalContentAlignment="Left" Click="OnNewCadFloorPlanClick">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="CAD Architectural Floor Plan" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Scale-Locked Rooms, Racks &amp; Walls" FontSize="11" Opacity="0.75" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Startup & Update Preferences -->
                        <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource VexioRibbonSurfaceBrush}"
                                BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Startup &amp; Software Updates" FontSize="13.5" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <CheckBox x:Name="AutoCheckUpdatesToggle" Content="Automatically check for updates on startup"
                                              IsChecked="True" Checked="OnAutoUpdatePrefChanged" Unchecked="OnAutoUpdatePrefChanged" />
                                    <CheckBox x:Name="SkipStartScreenCheck" Content="Skip start screen on launch (open blank page directly)"
                                              IsChecked="False" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Button Click="OnCheckUpdatesClick" Content="Check for Updates Now" />
                                    <TextBlock x:Name="BackstageUpdateStatusText" Text="Vexio v0.5.0-beta • Automatic background update check enabled."
                                               FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
