<Window
    x:Class="VexioWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:VexioWindows"
    mc:Ignorable="d"
    Title="Vexio Professional — Drawing1.vsdx">

    <Grid x:Name="RootWorkstationGrid" RequestedTheme="Light" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnPointerToolAccelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnTextToolAccelerator" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnConnectorToolAccelerator" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnSaveAsAccelerator" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnTiledPrintAccelerator" />
            <KeyboardAccelerator Key="F4" Modifiers="Shift" Invoked="OnPageSetupAccelerator" />
            <KeyboardAccelerator Key="F5" Modifiers="Shift" Invoked="OnToggleShapeSheetAccelerator" />
            <KeyboardAccelerator Key="F9" Modifiers="Menu" Invoked="OnMacroEditorAccelerator" />
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnGroupAccelerator" />
            <KeyboardAccelerator Key="G" Modifiers="Control,Shift" Invoked="OnUngroupAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <!-- Row 0: Quick Access Toolbar & Custom App Title Bar -->
            <RowDefinition Height="36" />
            <!-- Row 1: Multi-Tabbed Enterprise Ribbon -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Diagnostic / Guard / Validation InfoBar -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Main Workstation (Left Stencils Dock | Center DX12 SwapChain + Rulers | Right Task Panes) -->
            <RowDefinition Height="*" MinHeight="220" />
            <!-- Row 4: ShapeSheet Split-View GridSplitter -->
            <RowDefinition x:Name="ShapeSheetSplitterRow" Height="0" />
            <!-- Row 5: Dockable Bottom ShapeSheet Editor Split-View -->
            <RowDefinition x:Name="ShapeSheetPaneRow" Height="0" />
            <!-- Row 6: Bottom Page Tabs Strip -->
            <RowDefinition Height="32" />
            <!-- Row 7: Enterprise Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- ROW 0: QUICK ACCESS TOOLBAR (QAT) & TITLE BAR                       -->
        <!-- =================================================================== -->
        <Grid x:Name="AppTitleBarGrid" Grid.Row="0" Background="{StaticResource VexioBrandDarkHeaderBrush}" Padding="8,0,148,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Quick Access Toolbar -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- App Vector Emblem -->
                <Border Background="#FF3B82F6" CornerRadius="4" Width="24" Height="24" Margin="2,0,8,0" VerticalAlignment="Center">
                    <PathIcon Foreground="White" Width="14" Height="14"
                              Data="M 2,3 L 7,13 L 12,3 L 9.5,3 L 7,8.5 L 4.5,3 Z" />
                </Border>

                <Button x:Name="QatSaveButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnSaveClick"
                        ToolTipService.ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save Document">
                    <PathIcon Width="14" Height="14" Data="M 2,1 L 11,1 L 14,4 L 14,14 L 2,14 Z M 4,2 L 4,6 L 10,6 L 10,2 Z M 4,9 L 4,13 L 12,13 L 12,9 Z" />
                </Button>

                <Button x:Name="QatSaveAsButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnSaveAsClick"
                        Padding="6,2" ToolTipService.ToolTip="Save As... (Ctrl+Shift+S)" AutomationProperties.Name="Save As">
                    <TextBlock x:Name="QatSaveAsLabel" Text="Save As…" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                </Button>

                <Button x:Name="QatOpenButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnOpenClick"
                        ToolTipService.ToolTip="Open Diagram or CAD Drawing (Ctrl+O)" AutomationProperties.Name="Open File">
                    <PathIcon Width="14" Height="14" Data="M 1,3 L 6,3 L 8,5 L 15,5 L 15,13 L 1,13 Z" />
                </Button>

                <Button x:Name="QatUndoButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnUndoClick"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                    <PathIcon Width="14" Height="14" Data="M 6,3 L 1,7.5 L 6,12 L 6,9 C 10,9 12.5,10.5 14,13 C 13.5,8.5 10.5,6 6,6 Z" />
                </Button>

                <Button x:Name="QatRedoButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnRedoClick"
                        ToolTipService.ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                    <PathIcon Width="14" Height="14" Data="M 10,3 L 15,7.5 L 10,12 L 10,9 C 6,9 3.5,10.5 2,13 C 2.5,8.5 5.5,6 10,6 Z" />
                </Button>

                <Button x:Name="QatTiledPrintButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnTiledPrintClick"
                        ToolTipService.ToolTip="Multi-Page Tiled Print with Registration Marks (Ctrl+P)" AutomationProperties.Name="Tiled Print">
                    <PathIcon Width="14" Height="14" Data="M 4,1 L 12,1 L 12,5 L 15,5 L 15,11 L 12,11 L 12,15 L 4,15 L 4,11 L 1,11 L 1,5 L 4,5 Z M 6,9 L 6,13 L 10,13 L 10,9 Z" />
                </Button>

                <ToggleButton x:Name="QatTouchMouseToggle" Padding="6,4" Background="Transparent" BorderBrush="Transparent"
                              Foreground="White" Click="OnTouchMouseModeToggle"
                              ToolTipService.ToolTip="Switch Touch / Mouse Ribbon Density" AutomationProperties.Name="Touch or Mouse Mode">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Width="13" Height="13" Data="M 7,1 C 8.1,1 9,1.9 9,3 L 9,7 L 12,7 C 13.1,7 14,7.9 14,9 L 13,14 L 5,14 L 3,10 L 4.5,9 L 6,10.5 L 6,3 C 6,1.9 6.5,1 7,1 Z" />
                        <TextBlock x:Name="TouchModeLabel" Text="Mouse" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Button x:Name="QatThemeToggleButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnThemeModeToggleClick"
                        ToolTipService.ToolTip="Switch Light / Dark Appearance (Default: Light)">
                    <TextBlock x:Name="ThemeModeLabel" Text="Light UI" FontSize="11" VerticalAlignment="Center" />
                </Button>
            </StackPanel>

            <!-- Document Title (Double-Click to Select All & Rename Inline) & Format Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8" Margin="14,0,0,0">
                <Button x:Name="DocumentTitleButton" Background="Transparent" BorderBrush="Transparent" Padding="6,2"
                        IsDoubleTapEnabled="True" DoubleTapped="OnDocumentTitleDoubleTapped"
                        ToolTipService.ToolTip="Double-click to rename document">
                    <TextBlock x:Name="DocumentTitleText" Text="Drawing1.vsdx" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
                <TextBox x:Name="DocumentTitleEditBox" Visibility="Collapsed" Width="220" FontSize="12.5" Padding="6,2"
                         KeyDown="OnDocumentTitleEditKeyDown" LostFocus="OnDocumentTitleEditLostFocus" />
                <Border Background="#33FFFFFF" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentFormatBadgeText" Text="OpenXML VSDX • Lossless" Foreground="#FFE2E8F0" FontSize="10.5" />
                </Border>
            </StackPanel>

            <!-- Language Switcher (EN/DE/IT/FR/ES/GR), Updates & GPU Indicator -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ComboBox x:Name="AppLanguageCombo" Width="76" SelectedIndex="0" FontSize="11" Padding="6,2"
                          SelectionChanged="OnAppLanguageChanged" ToolTipService.ToolTip="Application Language (EN, DE, IT, FR, ES, GR)">
                    <x:String>EN</x:String>
                    <x:String>DE</x:String>
                    <x:String>IT</x:String>
                    <x:String>FR</x:String>
                    <x:String>ES</x:String>
                    <x:String>GR</x:String>
                </ComboBox>
                <Button x:Name="CheckUpdatesTitleButton" Style="{StaticResource VexioQatButtonStyle}" Click="OnCheckUpdatesClick"
                        ToolTipService.ToolTip="Check for Updates...">
                    <TextBlock x:Name="CheckUpdatesTitleLabel" Text="Updates" FontSize="11" VerticalAlignment="Center" />
                </Button>
                <Border Background="#26FFFFFF" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="GpuSwapChainBadgeText" Text="DX12 SwapChain • Ready" Foreground="#FFBAE6FD" FontSize="11" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- =================================================================== -->
        <!-- ROW 1: MULTI-TABBED VISIO PROFESSIONAL RIBBON                       -->
        <!-- =================================================================== -->
        <Border Grid.Row="1" Background="{ThemeResource VexioRibbonSurfaceBrush}" BorderBrush="{ThemeResource VexioRibbonGroupBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition x:Name="RibbonBodyRow" Height="88" />
                </Grid.RowDefinitions>

                <!-- Ribbon Tab Header Strip (File In-App Hub + 8 Core Visio Tabs + Sibling Hover Menus + Collapse Toggle) -->
                <Grid Grid.Row="0" Padding="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- FILE IN-APP BACKSTAGE BUTTON -->
                            <Button x:Name="FileBackstageButton" Background="{StaticResource VexioBrandPrimaryBrush}" Foreground="White"
                                    FontWeight="SemiBold" Padding="14,4" CornerRadius="4" VerticalAlignment="Center"
                                    Click="OnFileBackstageToggleClick" PointerEntered="OnTopMenuPointerEntered" Tag="FileMenu"
                                    AutomationProperties.Name="File Backstage Menu">
                                <TextBlock x:Name="FileTabLabelText" Text="File" FontSize="12.5" />
                            </Button>

                            <!-- Classic 8 Visio Ribbon Tabs (Auto-sized so DE/IT/FR/ES/GR never truncate) -->
                            <RadioButton x:Name="RibbonTabHome" Content="Home" GroupName="RibbonTabs" IsChecked="True" Checked="OnRibbonTabChanged" Tag="Home" Padding="10,4" />
                            <RadioButton x:Name="RibbonTabInsert" Content="Insert" GroupName="RibbonTabs" Checked="OnRibbonTabChanged" Tag="Insert" Padding="10,4" />
                            <RadioButton x:Name="RibbonTabDesign" Content="Design" GroupName="RibbonTabs" Checked="OnRibbonTabChanged" Tag="Design" Padding="10,4" />
                            <RadioButton x:Name="RibbonTabData" Content="Data" GroupName="RibbonTabs" Checked="OnRibbonTabChanged" Tag="Data" Padding="10,4" />
                            <RadioButton x:Name="RibbonTabProcess" Content="Process" GroupName="RibbonTabs" Checked="OnRibbonTabChanged" Tag="Process" Padding="10,4" />
                            <RadioButton x:Name="RibbonTabReview" Content="Review" GroupName="RibbonTabs" Checked="OnRibbonTabChanged" Tag="Review" Padding="10,4" />
                            <RadioButton x:Name="RibbonTabView" Content="View" GroupName="RibbonTabs" Checked="OnRibbonTabChanged" Tag="View" Padding="10,4" />
                            <RadioButton x:Name="RibbonTabDeveloper" Content="Developer" GroupName="RibbonTabs" Checked="OnRibbonTabChanged" Tag="Developer" Padding="10,4" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Hover-Switch Quick Menus & Collapse Ribbon Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="TopExportMenuButton" Padding="8,3" Background="Transparent" BorderBrush="Transparent"
                                PointerEntered="OnTopMenuPointerEntered" Tag="ExportMenu">
                            <TextBlock x:Name="TopExportMenuLabel" Text="Export ▾" FontSize="11.5" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="TopExportMenuFlyout" Opened="OnTopFlyoutOpened" Closed="OnTopFlyoutClosed">
                                    <MenuFlyoutItem Text="Save As... (Ctrl+Shift+S)" Click="OnSaveAsClick" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Export Archival PDF/A (.pdf)" Click="OnExportPdfClick" />
                                    <MenuFlyoutItem Text="Export Vector SVG (.svg)" Click="OnExportSvgClick" />
                                    <MenuFlyoutItem Text="Export High-DPI PNG (.png)" Click="OnExportPngClick" />
                                    <MenuFlyoutItem Text="Export JPEG (.jpg)" Click="OnExportJpgClick" />
                                    <MenuFlyoutItem Text="Export AutoCAD DXF (.dxf)" Click="OnExportDxfClick" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="PowerPoint Deck (.pptx)" Click="OnExportPptxClick" />
                                    <MenuFlyoutItem Text="Word Process Spec (.docx)" Click="OnExportDocxClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="TopHelpMenuButton" Padding="8,3" Background="Transparent" BorderBrush="Transparent"
                                PointerEntered="OnTopMenuPointerEntered" Tag="HelpMenu">
                            <TextBlock x:Name="TopHelpMenuLabel" Text="Help &amp; Updates ▾" FontSize="11.5" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="TopHelpMenuFlyout" Opened="OnTopFlyoutOpened" Closed="OnTopFlyoutClosed">
                                    <MenuFlyoutItem Text="Check for Updates..." Click="OnCheckUpdatesClick" />
                                    <MenuFlyoutItem Text="Import Visio Stencil (.vssx / .vss)..." Click="OnImportStencilClick" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Open Welcome / Start Screen" Click="OnFileBackstageToggleClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="RibbonCollapseToggleButton" Padding="8,3" Background="Transparent" BorderBrush="Transparent"
                                Click="OnToggleRibbonCollapseClick" ToolTipService.ToolTip="Collapse / Pin Classic Visio Ribbon">
                            <TextBlock x:Name="RibbonCollapseGlyphText" Text="⌃" FontSize="12" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- RIBBON BODY PANELS -->
                <ScrollViewer x:Name="RibbonBodyScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10,4">
                    <Grid>
                        <!-- 1. HOME RIBBON PANEL -->
                        <StackPanel x:Name="RibbonPanelHome" Orientation="Horizontal" Spacing="10" Visibility="Visible">
                            <!-- Clipboard Group -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Height="56">
                                    <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnPasteShapeClick" ToolTipService.ToolTip="Paste Shape (Ctrl+V)">
                                        <StackPanel Spacing="3">
                                            <PathIcon Width="16" Height="16" Data="M 5,1 L 11,1 L 11,3 L 14,3 L 14,15 L 2,15 L 2,3 L 5,3 Z" />
                                            <TextBlock Text="Paste" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnCutShapeClick" Content="Cut" Padding="6,2" />
                                        <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnCopyShapeClick" Content="Copy" Padding="6,2" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnDuplicateShapeClick" Content="Duplicate" Padding="6,2" />
                                        <Button Style="{StaticResource VexioRibbonButtonStyle}" Click="OnDeleteShapeClick" Content="Delete" Padding="6,2" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Clipboard" Style="{StaticResource VexioRibbonGroupLabelStyle}" />
                            </StackPanel>
                            <AppBarSeparator />

                            <!-- Font & Paragraph Rich Text Group (Native DirectWrite Fonts + Full Native WinUI 3 ColorPicker) -->
                            <StackPanel>
                                <StackPanel Spacing="3" Height="56" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ComboBox x:Name="FontFamilyCombo" Width="154" SelectedIndex="0" FontSize="11.5" Padding="6,2"
                                                  SelectionChanged="OnFontFormattingComboChanged" ToolTipService.ToolTip="Installed Windows OS Fonts (DirectWrite)">
                                            <x:String>Segoe UI</x:String>
                                            <x:String>Inter</x:String>
                                            <x:String>Calibri</x:String>
                                            <x:String>Arial</x:String>
                                            <x:String>Consolas</x:String>
                                            <x:String>Georgia</x:String>
                                            <x:String>Times New Roman</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="FontSizeCombo" Width="64" SelectedIndex="3" FontSize="11.5" Padding="6,2"
                                                  SelectionChanged="OnFontFormattingComboChanged" ToolTipService.ToolTip="Font Size (pt)">
                                            <x:String>8</x:String>
                                            <x:String>9</x:String>
                                            <x:String>10</x:String>
                                            <x:String>11</x:String>
                                            <x:String>12</x:String>
                                            <x:String>14</x:String>
                                            <x:String>16</x:String>
                                            <x:String>18</x:String>
                                            <x:String>24</x:String>
                                            <x:String>36</x:String>
                                            <x:String>48</x:String>
                                        </ComboBox>
                                        <Button Padding="7,2" Content="Headings ▾" FontSize="11" FontWeight="SemiBold"
                                                ToolTipService.ToolTip="Apply Visio Title / Heading Style to Selection (or Insert onto Page)">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Diagram Title (24 pt Bold)" Tag="title" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutItem Text="Subtitle (14 pt)" Tag="subtitle" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutItem Text="Heading 1 — Underlined (18 pt)" Tag="h1" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutItem Text="Heading 2 (14 pt Bold)" Tag="h2" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutItem Text="Heading 3 (12 pt Accent)" Tag="h3" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutItem Text="Section Header Banner" Tag="section_banner" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutItem Text="Accent Callout Header" Tag="callout_title" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Body Text (11 pt)" Tag="body" Click="OnHeadingPresetMenuClick" />
                                                    <MenuFlyoutItem Text="Caption / Note (9.5 pt)" Tag="caption" Click="OnHeadingPresetMenuClick" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Padding="5,2" Click="OnGrowFontSizeClick" Content="A▲" FontSize="10.5" ToolTipService.ToolTip="Increase Font Size" />
                                        <Button Padding="5,2" Click="OnShrinkFontSizeClick" Content="A▼" FontSize="10.5" ToolTipService.ToolTip="Decrease Font Size" />
                                        <Button Padding="7,2" Content="A Color ▾" FontSize="11" ToolTipService.ToolTip="Text Color (Native OS Color Picker)">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="TextColorPickerControl"
                                                                 ColorSpectrumShape="Box"
                                                                 IsMoreButtonVisible="True"
                                                                 IsColorSliderVisible="True"
                                                                 IsColorChannelTextInputVisible="True"
                                                                 IsHexInputVisible="True"
                                                                 IsAlphaEnabled="False"
                                                                 ColorChanged="OnTextColorPickerChanged" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Padding="7,2" Content="ab Highlight ▾" FontSize="11" ToolTipService.ToolTip="Text Highlight (Native OS Color Picker)">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel Spacing="8">
                                                        <Button HorizontalAlignment="Stretch" Content="No Highlight (Clear)" Click="OnClearTextHighlightClick" />
                                                        <ColorPicker x:Name="TextHighlightPickerControl"
                                                                     ColorSpectrumShape="Box"
                                                                     IsMoreButtonVisible="True"
                                                                     IsColorSliderVisible="True"
                                                                     IsColorChannelTextInputVisible="True"
                                                                     IsHexInputVisible="True"
                                                                     IsAlphaEnabled="False"
                                                                     ColorChanged="OnTextHighlightPickerChanged" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <ComboBox x:Name="FontColorCombo" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="OnFontFormattingComboChanged">
                                            <x:String>Slate</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="TextHighlightCombo" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="OnFontFormattingComboChanged">
                                            <x:String>No Highlight</x:String>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <ToggleButton x:Name="BoldTextToggle" Padding="7,1" FontWeight="Bold" Content="B" Click="OnTextStyleToggleClick" ToolTipService.ToolTip="Bold" />
                                        <ToggleButton x:Name="ItalicTextToggle" Padding="7,1" FontStyle="Italic" Content="I" Click="OnTextStyleToggleClick" ToolTipService.ToolTip="Italic" />
                                        <ToggleButton x:Name="UnderlineTextToggle" Padding="7,1" Content="U̲" Click="OnTextStyleToggleClick" ToolTipService.ToolTip="Underline" />
                                        <ToggleButton x:Name="StrikeTextToggle" Padding="7,1" Content="S̶" Click="OnTextStyleToggleClick" ToolTipService.ToolTip="Strikethrough" />
                                        <Border Width="1" Background="{ThemeResource VexioRibbonGroupBorderBrush}" Margin="3,2" />
                                        <Button Padding="6,1" Click="OnTextAlignLeftClick" Content="⇤" FontSize="11" ToolTipService.ToolTip="Align Text Left" />
                                        <Button Padding="6,1" Click="OnTextAlignCenterClick" Content="⇔" FontSize="11" ToolTipService.ToolTip="Center Text" />
                                        <Button Padding="6,1" Click="OnTextAlignRightClick" Content="⇥" FontSize="11" ToolTipService.ToolTip="Align Text Right" />
                                        <Border Width="1" Background="{ThemeResource VexioRibbonGroupBorderBrush}" Margin="3,2" />
                                        <Button Padding="6,1" Click="OnTextVAlignTopClick" Content="⤒" FontSize="11" ToolTipService.ToolTip="Top Vertical Align" />
                                        <Button Padding="6,1" Click="OnTextVAlignMiddleClick" Content="↕" FontSize="11" ToolTipService.ToolTip="Middle Vertical Align" />
                                        <Button Padding="6,1" Click="OnTextVAlignBottomClick" Content="⤓" FontSize="11" ToolTipService.ToolTip="Bottom Vertical Align" />
                                        <Border Width="1" Background="{ThemeResource VexioRibbonGroupBorderBrush}" Margin="3,2" />
                                        <ToggleButton x:Name="BulletListToggle" Padding="7,1" Content="• List" FontSize="11" Click="OnBulletListToggleClick" ToolTipService.ToolTip="Bulleted List" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Font &amp; Paragraph" Style="{StaticResource VexioRibbonGroupLabelStyle}" />
                            </StackPanel>
                            <AppBarSeparator />

                            <!-- Tools Group (Ctrl+1 Pointer, Ctrl+2 Text, Ctrl+3 Connector) -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Height="56">
                                    <ToggleButton x:Name="PointerToolToggle" Style="{StaticResource VexioRibbonToggleButtonStyle}" IsChecked="True"
                                                  Click="OnPointerToolClick" ToolTipService.ToolTip="Pointer Tool (Ctrl+1)">
                                        <StackPanel Spacing="3">
                                            <PathIcon Width="16" Height="16" Data="M 3,1 L 3,13 L 6.5,9.8 L 9,15 L 11,14 L 8.5,9 L 13,9 Z" />
                                            <TextBlock Text="Pointer" FontSize="11" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="TextToolToggle" Style="{StaticResource VexioRibbonToggleButtonStyle}"
                                                  Click="OnTextToolClick" ToolTipService.ToolTip="Text Block / Rich Text Tool (Ctrl+2)">
                                        <StackPanel Spacing="3">
                                            <PathIcon Width="16" Height="16" Data="M 2,2 L 14,2 L 14,5 L 12,5 L 12,4 L 9,4 L 9,13 L 11,13 L 11,15 L 5,15 L 5,13 L 7,13 L 7,4 L 4,4 L 4,5 L 2,5 Z" />
                                            <TextBlock Text="Text" FontSize="11" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ConnectorToolToggle" Style="{StaticResource VexioRibbonToggleButtonStyle}"
                                                  Click="OnConnectorToolClick" ToolTipService.ToolTip="Dynamic Obstacle-Avoiding Connector (Ctrl+3)">
                                        <StackPanel Spacing="3">
