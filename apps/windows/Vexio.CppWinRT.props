<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <XamlLanguage>CppWinRT</XamlLanguage>
    <CppWinRTProjectLanguage>C++/WinRT</CppWinRTProjectLanguage>
    <CanReferenceWinRT>true</CanReferenceWinRT>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAsWinRT>false</CompileAsWinRT>
      <AdditionalIncludeDirectories>$(GeneratedFilesDir);$(GeneratedFilesDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
